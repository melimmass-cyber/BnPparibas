{
  "name": "bnp-wealth-luxembourg-rebuild",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/local.js",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "dev:ui": "vite",
    "start": "node --env-file-if-exists=.env server.js",
    "db:migrate": "node --env-file-if-exists=.env server.js --migrate",
    "user:manage": "node --env-file-if-exists=.env server/manage-user.js",
    "test": "node --test server/tests/*.test.js",
    "dev:backend": "node --env-file-if-exists=.env --watch server.js",
    "local": "node scripts/local.js"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.2",
    "@fastify/cors": "^11.3.0",
    "@fastify/helmet": "^13.1.1",
    "@fastify/static": "^10.1.2",
    "fastify": "^5.12.4",
    "openid-client": "^6.8.8",
    "pg": "^8.23.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@types/node": "^24.10.0",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.2",
    "typescript": "^5.9.2",
    "vite": "^7.1.3"
  },
  "engines": {
    "node": ">=24 <27"
  }
