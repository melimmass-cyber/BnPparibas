NODE_ENV=development
HOST=127.0.0.1
PORT=3000
APP_ORIGIN=http://localhost:3000
DATABASE_URL=postgresql://portal:replace-me@localhost:5432/portal
DATABASE_SSL=disable
# For the optional local Docker database; match DATABASE_URL's password.
POSTGRES_PASSWORD=
# Production: DATABASE_SSL=verify-full; optionally set DATABASE_CA_FILE.
SESSION_ENCRYPTION_KEY=
SESSION_SECONDS=3600
SESSION_IDLE_SECONDS=900
# All four OIDC fields must be provided together. Never guess production endpoints.
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# Provider-documented ACR value proving the required MFA assurance level.
OIDC_REQUIRED_ACR=
# Exact trusted proxy IPs/CIDRs only. Leave empty when connecting directly.
TRUSTED_PROXIES=
